# Copy to deploy/.env on the server and fill in. Never commit the real file.

# --- Infra ---
API_DOMAIN=auberge-api.hugo-calmels.fr
POSTGRES_PASSWORD=

# --- App ---
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Public URL of the Netlify frontend (CORS + Stripe redirects)
FRONTEND_ORIGIN=https://auberge-du-fauxcalm.netlify.app
FRONTEND_URL=https://auberge-du-fauxcalm.netlify.app

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Brevo (emails) ---
BREVO_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=

# --- Off-site backups to Backblaze B2 (optional, see deploy/backup.sh) ---
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

# --- One-off seed only (npx tsx prisma/seed.ts wipes the DB!) ---
SEED_ADMIN_EMAIL=owner@auberge.com
SEED_ADMIN_PASSWORD=
